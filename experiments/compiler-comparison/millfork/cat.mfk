import cpm_bdos

inline asm byte open_default_fcb() {
    ? lxi d,$005c
    ? mvi c,15
    call 5
    ? ret
}

inline asm byte read_default_fcb() {
    ? lxi d,$005c
    ? mvi c,20
    call 5
    ? ret
}

void putsz(pointer p) {
    while p[0] != 0 {
        putchar(p[0])
        p += 1
    }
}

void main() {
    pointer dma
    byte i
    byte c
    dma = $0080
    if open_default_fcb() == $ff {
        putsz("CAT: not found"z)
        new_line()
        return
    }
    while read_default_fcb() == 0 {
        i = 0
        while i != 128 {
            c = dma[i]
            if c == $1a { return }
            putchar(c)
            i += 1
        }
    }
}
