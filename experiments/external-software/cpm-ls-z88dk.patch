diff --git a/conio_z88dk.c b/conio_z88dk.c
new file mode 100644
index 0000000..c35cdd6
--- /dev/null
+++ b/conio_z88dk.c
@@ -0,0 +1,44 @@
+/* z88dk console adapter for cpm-ls.
+ * Copyright (c) 2026 Danila Sukharev
+ * SPDX-License-Identifier: GPL-3.0-only
+ */
+
+#include "compat.h"
+
+void putch(c)
+char c;
+{
+    bdos(2, c);
+}
+
+void puts2(s)
+char *s;
+{
+    while (*s)
+        putch(*s++);
+}
+
+void puteol()
+{
+    putch(13);
+    putch(10);
+}
+
+void puthex(n)
+unsigned n;
+{
+    int shift;
+    for (shift = 12; shift >= 0; shift -= 4) {
+        int digit = (n >> shift) & 15;
+        putch(digit < 10 ? digit + '0' : digit - 10 + 'A');
+    }
+}
+
+int getchne()
+{
+    int c;
+    do {
+        c = bdos(6, 0xff);
+    } while (c == 0);
+    return c;
+}
