{
  "schema": "cpm-plus-juku-volume-profile-v1",
  "extends": "recovery.json",
  "name": "native-recovery-a",
  "description": "Post-C4 recovery A: with native Juku configuration and resident-system status",
  "files": [
    {
      "source": "build/diag.cim",
      "destination": "0:DIAG.COM",
      "override": true,
      "provenance": {
        "source": "src/diag.asm and pinned juku-common diagnostics",
        "version": "Juku Diag 0.5",
        "license": "LICENSE and third_party/juku-common notices"
      }
    },
    {
      "source": "build/status.cim",
      "destination": "0:STATUS.COM",
      "provenance": {
        "source": "src/status.asm",
        "version": "Juku Status 1.3",
        "license": "LICENSE"
      }
    },
    {
      "source": "build/keytest.cim",
      "destination": "0:KEYTEST.COM",
      "provenance": {
        "source": "src/keytest.asm",
        "version": "Juku Keytest 1.1",
        "license": "LICENSE"
      }
    }
  ]
}
