{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ddanila/cpm-plus-juku/physical/display-observation.schema.json",
  "title": "Juku CP/M Plus four-mode physical display observations",
  "type": "object",
  "required": ["schema", "board", "monitor", "observations"],
  "properties": {
    "schema": {"const": "cpm-plus-juku-display-observations-v1"},
    "board": {"const": "CS00015"},
    "monitor": {
      "type": "object",
      "required": ["manufacturer", "model", "input"],
      "properties": {
        "manufacturer": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "input": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "observations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "mode", "raw_s21", "geometry", "result_directory",
          "edges_visible", "glyphs_readable", "locale_stable",
          "cursor_blinked", "joined_cp437", "framebuffer_fault",
          "monitor_cropping", "photos"
        ],
        "properties": {
          "mode": {"type": "integer", "minimum": 0, "maximum": 3},
          "raw_s21": {"enum": ["01", "03", "05", "07"]},
          "geometry": {"enum": ["40x24", "53x24", "64x20", "80x24"]},
          "result_directory": {"type": "string", "minLength": 1},
          "edges_visible": {"type": "boolean"},
          "glyphs_readable": {"const": true},
          "locale_stable": {"const": true},
          "cursor_blinked": {"const": true},
          "joined_cp437": {"oneOf": [{"const": true}, {"const": "not-applicable"}]},
          "framebuffer_fault": {"const": false},
          "monitor_cropping": {"type": "string"},
          "notes": {"type": "string"},
          "photos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "sha256"],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
