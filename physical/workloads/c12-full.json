{
  "schema": "cpm-plus-juku-physical-workload-v1",
  "name": "c12-full",
  "volume_profile": "c12-full-a",
  "boot_expect": ["CP/M Plus 3.1 Juku", "N3 19200"],
  "required_coverage": [
    "CONSOLE.COM", "DATE.COM", "DIAG.COM", "PIP.COM", "README.TXT",
    "STATUS.COM", "VER.COM", "WBOOT.COM"
  ],
  "commands": [
    {
      "name": "dir-a",
      "command": "DIR",
      "expect": ["CONSOLE", "DIAG", "PIP", "STATUS", "VER"]
    },
    {
      "name": "type-readme",
      "command": "TYPE README.TXT",
      "expect": ["host-backed NetDisk-v3", "Project:"],
      "coverage": ["README.TXT"]
    },
    {
      "name": "status-cold",
      "command": "STATUS",
      "expect": [
        "Juku Status 1.6",
        "ROM: Juku ABI 01.05",
        "Map: TPA 0100-9BFF",
        "Active video: 03 (80x24)",
        "Active charset: 01 Estonian",
        "Video override: no",
        "Charset override: no",
        "PPI0 Port C: 01  POF: released (picture enabled)",
        "Boot marker (00 cold/01 warm): 00  POST: 00  ROM ABI: 00",
        "Disk status: 00",
        "N4 last failure: 00",
        "N4 state flags: 0F",
        "N4 failure reason: none"
      ],
      "resume_expect": [
        "Juku Status 1.6",
        "ROM: Juku ABI 01.05",
        "Map: TPA 0100-9BFF",
        "Active video: 03 (80x24)",
        "Active charset: 01 Estonian",
        "Video override: no",
        "Charset override: no",
        "PPI0 Port C: 01  POF: released (picture enabled)",
        "POST: 00  ROM ABI: 00",
        "Disk status: 00",
        "Host caps: NetDisk v03"
      ],
      "coverage": ["STATUS.COM"]
    },
    {
      "name": "ver",
      "command": "VER",
      "expect": ["CP/M Plus 3.1 for Juku"],
      "coverage": ["VER.COM"]
    },
    {
      "name": "date-error-path",
      "command": "DATE BAD",
      "expect": ["Illegal time/date specification"],
      "coverage": ["DATE.COM"]
    },
    {
      "name": "diag-all",
      "command": "DIAG ALL",
      "expect": [
        "Juku Diag 0.8",
        "JukuNet C12 ROM ABI 1.5 runtime console 2026-09-04",
        "CPU: PASS",
        "RAM data: PASS",
        "RAM address: PASS",
        "RAM retention: PASS",
        "Checksum: PASS",
        "D57 PIT clock: PASS",
        "D11 USART status: PASS",
        "ROM image: PASS",
        "Video enable/console state: PASS",
        "Keyboard/S21: PASS"
      ],
      "coverage": ["DIAG.COM"]
    },
    {
      "name": "pip-copy",
      "command": "PIP C12COPY.TXT=README.TXT",
      "coverage": ["PIP.COM"]
    },
    {
      "name": "type-copy",
      "command": "TYPE C12COPY.TXT",
      "expect": ["host-backed NetDisk-v3", "Project:"]
    },
    {"name": "erase-copy", "command": "ERA C12COPY.TXT"},
    {
      "name": "dir-after-erase",
      "command": "DIR",
      "expect": ["CONSOLE", "DIAG", "PIP", "README", "STATUS", "VER"]
    },
    {"name": "select-b", "command": "B:", "prompt": "B>"},
    {
      "name": "dir-b",
      "command": "DIR",
      "prompt": "B>",
      "expect": ["DIAG", "README"]
    },
    {"name": "select-a", "command": "A:", "prompt": "A>"},
    {
      "name": "set-runtime-pair",
      "command": "CONSOLE MODE 40",
      "expect": ["Active: 40x24 / Estonian", "Override: video=yes"],
      "coverage": ["CONSOLE.COM"]
    },
    {
      "name": "warm-boot",
      "command": "WBOOT",
      "coverage": ["WBOOT.COM"]
    },
    {
      "name": "status-warm-override",
      "command": "STATUS",
      "expect": [
        "Juku Status 1.6",
        "ROM: Juku ABI 01.05",
        "Active video: 00 (40x24)",
        "Active charset: 01 Estonian",
        "Video override: yes",
        "Charset override: no",
        "PPI0 Port C: 01  POF: released (picture enabled)",
        "Boot marker (00 cold/01 warm): 01  POST: 00  ROM ABI: 00",
        "Disk status: 00",
        "N4 last failure: 00",
        "N4 state flags: 0F",
        "N4 failure reason: none"
      ],
      "resume_expect": [
        "Juku Status 1.6",
        "ROM: Juku ABI 01.05",
        "Active video: 00 (40x24)",
        "Active charset: 01 Estonian",
        "Video override: yes",
        "Charset override: no",
        "PPI0 Port C: 01  POF: released (picture enabled)",
        "Boot marker (00 cold/01 warm): 01  POST: 00  ROM ABI: 00",
        "Disk status: 00",
        "Host caps: NetDisk v03"
      ]
    },
    {
      "name": "restore-default",
      "command": "CONSOLE DEFAULT",
      "expect": [
        "Active: 80x24 / Estonian",
        "Override: video=no", "  charset=no"
      ]
    }
  ]
}
