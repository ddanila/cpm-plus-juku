{
  "schema": "cpm-plus-juku-physical-workload-v1",
  "name": "development",
  "volume_profile": "development-a",
  "boot_expect": ["CP/M Plus 3.1 Juku", "N3 19200"],
  "required_coverage": ["DIAG.COM", "ED.COM", "HEXCOM.COM", "PATCH.COM", "SID.COM", "WBOOT.COM"],
  "commands": [
    {"name": "dir", "command": "DIR", "expect": ["HEXCOM", "SID", "PATCH", "ED"]},
    {"name": "type-readme", "command": "TYPE README.TXT", "expect": ["host-backed NetDisk-v3"]},
    {"name": "diag-cpu", "command": "DIAG CPU", "expect": ["CPU: PASS"], "coverage": ["DIAG.COM"]},
    {"name": "hexcom", "command": "HEXCOM HELLO", "coverage": ["HEXCOM.COM"]},
    {"name": "hello", "command": "HELLO", "expect": ["Juku dev profile"]},
    {
      "name": "sid",
      "command": "SID HELLO.COM",
      "steps": [{"wait": "#", "send_hex": "51 0d"}],
      "expect": ["#"],
      "coverage": ["SID.COM"]
    },
    {"name": "patch", "command": "PATCH SID", "expect": ["Current patches for"], "coverage": ["PATCH.COM"]},
    {
      "name": "ed",
      "command": "ED EDTEST.TXT",
      "steps": [
        {"wait": ": *", "send_hex": "49 45 64 69 74 65 64 20 6f 6e 20 4a 75 6b 75 20 43 50 2f 4d 20 50 6c 75 73 20 33 2e 31 1a 0d", "delay": 1},
        {"wait": "\r\n*", "send_hex": "45 0d", "delay": 1}
      ],
      "expect": ["NEW FILE"],
      "coverage": ["ED.COM"]
    },
    {"name": "type-ed", "command": "TYPE EDTEST.TXT", "expect": ["EDITED ON JUKU CP/M PLUS 3.1"]},
    {"name": "warm-boot-user-1", "command": "WBOOT", "coverage": ["WBOOT.COM"]}
  ]
}
