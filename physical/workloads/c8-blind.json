{
  "schema": "cpm-plus-juku-physical-workload-v1",
  "name": "c8-blind",
  "volume_profile": "c6-recovery-a",
  "boot_expect": [
    "CP/M Plus 3.1 Juku",
    "N3 19200"
  ],
  "required_coverage": [
    "DIAG.COM",
    "KEYTEST.COM",
    "N4BULK.COM",
    "SOAK.COM",
    "STATUS.COM",
    "WBOOT.COM"
  ],
  "commands": [
    {
      "name": "dir-a",
      "command": "DIR",
      "expect": [
        "DIAG",
        "N4BULK",
        "STATUS"
      ]
    },
    {
      "name": "status-cold",
      "command": "STATUS",
      "expect": [
        "Juku Status 1.3",
        "ROM: Juku ABI 01.03",
        "Map: TPA 0100-9BFF",
        "Transport: NetDisk v3, 19200 baud, N4 services",
        "Boot marker (00 cold/01 warm): 00  POST: 00  ROM ABI: 00",
        "Disk status: 00",
        "N4 last failure: 00",
        "Host caps: NetDisk v03"
      ],
      "coverage": [
        "STATUS.COM"
      ]
    },
    {
      "name": "diag-all",
      "command": "DIAG ALL",
      "expect": [
        "CPU: PASS",
        "RAM data: PASS",
        "RAM address: PASS",
        "RAM retention: PASS",
        "Checksum: PASS",
        "D57 PIT clock: PASS",
        "D11 USART status: PASS",
        "ROM ABI: PASS",
        "Video/console: PASS",
        "Keyboard/S21: PASS"
      ],
      "coverage": [
        "DIAG.COM"
      ]
    },
    {
      "name": "n4-bulk",
      "command": "N4BULK",
      "expect": [
        "N4 BULK PASS"
      ],
      "coverage": [
        "N4BULK.COM"
      ]
    },
    {
      "name": "keytest-remote",
      "command": "KEYTEST B",
      "steps": [
        {
          "wait": "Juku Keytest 1.1 READY",
          "send_hex": "41 20 31 0d 1b",
          "delay": 0.5
        }
      ],
      "expect": [
        "BATCH 04",
        "KEY 20 ' '",
        "KEY 1B",
        "Juku Keytest 1.1 DONE"
      ],
      "coverage": [
        "KEYTEST.COM"
      ]
    },
    {
      "name": "select-b",
      "command": "B:",
      "prompt": "B>"
    },
    {
      "name": "dir-b",
      "command": "DIR",
      "prompt": "B>",
      "expect": [
        "DIAG",
        "README"
      ]
    },
    {
      "name": "diag-all-b",
      "command": "DIAG ALL",
      "prompt": "B>",
      "expect": [
        "CPU: PASS",
        "D57 PIT clock: PASS",
        "D11 USART status: PASS",
        "ROM ABI: PASS"
      ]
    },
    {
      "name": "select-a",
      "command": "A:",
      "prompt": "A>"
    },
    {
      "name": "disk-soak",
      "command": "SOAK",
      "expect": [
        "SOAK: PASS"
      ],
      "coverage": [
        "SOAK.COM"
      ]
    },
    {
      "name": "warm-boot",
      "command": "WBOOT",
      "coverage": [
        "WBOOT.COM"
      ]
    },
    {
      "name": "status-warm",
      "command": "STATUS",
      "expect": [
        "ROM: Juku ABI 01.03",
        "Boot marker (00 cold/01 warm): 01  POST: 00  ROM ABI: 00",
        "Disk status: 00",
        "N4 last failure: 00"
      ]
    },
    {
      "name": "n4-bulk-after-warm",
      "command": "N4BULK",
      "expect": [
        "N4 BULK PASS"
      ]
    },
    {
      "name": "erase-readme",
      "command": "ERA README.TXT"
    },
    {
      "name": "dir-after-erase",
      "command": "DIR",
      "expect": [
        "DIAG",
        "N4BULK",
        "STATUS"
      ]
    }
  ]
}
